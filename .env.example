# База данных (PostgreSQL)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=cash_tracker
DB_USER=cash
DB_PASSWORD=change_me

# Бэкенд (Yii2)
YII_DEBUG=true
YII_ENV=dev
COOKIE_VALIDATION_KEY=change_me_to_random_string
CORS_ORIGINS=http://localhost:5173

# Порты на хосте
NGINX_PORT=8080
POSTGRES_PORT=5432
VITE_PORT=5173

# Фронтенд
VITE_API_URL=/api/v1
