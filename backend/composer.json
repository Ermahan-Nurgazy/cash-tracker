{
  "name": "cash-tracker/backend",
  "description": "Cash Tracker REST API (Yii2)",
  "type": "project",
  "license": "proprietary",
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require": {
    "php": ">=8.2",
    "ext-intl": "*",
    "ext-pdo": "*",
    "ext-pdo_pgsql": "*",
    "yiisoft/yii2": "~2.0.51",
    "zircote/swagger-php": "^7.8"
  },
  "require-dev": {
    "codeception/codeception": "^5.1",
    "codeception/module-asserts": "^3.0",
    "codeception/module-rest": "^3.3",
    "codeception/module-yii2": "^1.1",
    "yiisoft/yii2-gii": "~2.2.0"
  },
  "replace": {
    "bower-asset/inputmask": "*",
    "bower-asset/jquery": "*",
    "bower-asset/punycode": "*",
    "bower-asset/yii2-pjax": "*"
  },
  "autoload": {
    "psr-4": {
      "app\\": ""
    }
  },
  "config": {
    "allow-plugins": {
      "yiisoft/yii2-composer": true
    },
    "process-timeout": 1800,
    "sort-packages": true
  },
  "scripts": {
    "migrate": "php yii migrate --interactive=0",
    "test": "codecept run"
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  }
}
